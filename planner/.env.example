# Copy to .env.local and fill in. Everything here is public in the browser,
# so no secrets go in this file. Keys live in the backend's .env.

VITE_API_BASE=http://localhost:8080

# true runs the UI on built-in sample data with no backend at all.
VITE_USE_MOCKS=false

# Auth0. Leave blank to hide sign-in.
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://profound.api
