# Copy to .env and fill in. This file holds secrets: never commit .env.

PORT=8080
APP_NAME=MyUniCourses

# * lets the planner call the API from any address. To lock it down, list sites
# comma separated instead, e.g. http://localhost:5173,https://uschedule.ai
CORS_ORIGIN=*

# Skip uoCampus and serve built-in sample data. Handy offline or if their site is down.
USE_SAMPLE_DATA=false

# ---------- Gemini ----------
# aistudio.google.com/apikey
GEMINI_API_KEY=
# On the free tier gemini-3.8-flash is capped at 20 requests a day, which one demo run can
# use up. flash-lite has a separate, larger allowance and does these jobs fine.
# Switch to gemini-3.8-flash if billing is turned on.
GEMINI_MODEL=gemini-3.5-flash-lite
# How hard Gemini thinks when it builds the timetable: high (default, about 40s, reliable),
# medium, or low (faster, more clashing answers that fall back to the standard builder).
# GEMINI_BUILD_THINKING=high

# ---------- Auth0 ----------
# Your tenant domain, e.g. profound.us.auth0.com
AUTH0_DOMAIN=
# The API identifier you created in Auth0, e.g. https://profound.api
AUTH0_AUDIENCE=https://profound.api

# Machine-to-machine app, authorized for the Auth0 Management API
# with the read:user_idp_tokens scope. Needed for Google Calendar.
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=

# ---------- Rate My Professors ----------
# Defaults work. Only set these if lookups stop returning anything.
# The school id is base64("School-1452"), the University of Ottawa.
# RMP_SCHOOL_ID=U2Nob29sLTE0NTI=
# RMP_AUTH=Basic dGVzdDp0ZXN0
